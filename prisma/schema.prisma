generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id         String     @id @default(cuid())
  name       String
  department Department
  githubLink String?
  liveLink   String?
  imageLinks String[]
  doubts     String?
  marks      String     @default("")
  feedback   String?
  checked    Boolean    @default(false)
  accepted   Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  userId     String
  user       User       @relation(fields: [userId], references: [id])
}

model User {
  id               String                 @id @default(cuid())
  name             String
  email            String                 @unique
  password         String
  role             Role                   @default(MEMBER)

  college          College                @default(UIT)
  branch           String?
  otherCollegeName String?

  domains          UserDomain[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  resetToken       String?                @unique
  resetTokenExpiry DateTime?
  projects         Project[]
  createdQuizzes   Quiz[]                 @relation("QuizCreator")
  quizAttempts     QuizAttempt[]
  status           ApprovalStatus         @default(PENDING)

  bio              String?
  profilePhoto     String?
  birthDate        DateTime?
  github           String?
  linkedin         String?
  instagram        String?
  twitter          String?
  profileUpdates   ProfileUpdateRequest[]
  positionRequests PositionRequest[]
}

enum College {
  UIT
  SOIT
  OTHER
}
model UserDomain {
  id         String      @id @default(cuid())

  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  department Department
  position     Position   @default(LEARNER)   

  @@unique([userId, department])
}

model ProfileUpdateRequest {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  field      String
  oldValue   String?
  newValue   String
  status     ApprovalStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  reviewedAt DateTime?
  reviewedBy String?
}
model PositionRequest {
  id          String   @id @default(cuid())

  userId      String
  user        User @relation(fields: [userId], references: [id])

  department  Department
  position    Position?

  status      ApprovalStatus @default(PENDING)

  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
}

model Quiz {
  id          String        @id @default(cuid())
  title       String
  description String?
  department  Department
  status      QuizStatus    @default(DRAFT)
  timeLimit   Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   String
  questions   Question[]
  user        User          @relation("QuizCreator", fields: [createdBy], references: [id])
  attempts    QuizAttempt[]
}

model Question {
  id            String       @id @default(cuid())
  quizId        String
  type          QuestionType @default(MCQ)
  text          String
  options       String[]
  correctAnswer String?
  marks         Int          @default(1)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String    @id @default(cuid())
  userId      String
  quizId      String
  answers     String
  score       Float?
  feedback    String?
  status      String    @default("IN_PROGRESS")
  timeLeft    Int?
  createdAt   DateTime  @default(now())
  submittedAt DateTime?
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}
model Notification {
  id        String             @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  data      String?
  status    NotificationStatus @default(UNREAD)
  createdAt DateTime           @default(now())
  readAt    DateTime?
}

enum NotificationType {
  NEW_USER
  PROFILE_UPDATE
  PROJECT_SUBMISSION
}

enum NotificationStatus {
  UNREAD
  READ
  ACTIONED
}

enum Department {
  ASPER
  DSA
  WEB_DEVELOPMENT
  IOT
  GAME_DEVELOPMENT_ANIMATION
  DEVOPS_CLOUD
  ML_DATA_SCIENCE
  GRAPHICS
  CORPORATE_RELATIONS
  
 
  PHOTOGRAPHY_VIDEO_EDITING
}

enum Role {
  MEMBER
  ADMIN
}

enum QuizStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum QuestionType {
  MCQ
  DYNAMIC
  TRUE_FALSE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
enum Position {
  
  PRESIDENT
  VICE_PRESIDENT
  CHAIR_MEMBER
  SECRETARY
  OPEN_SOURCE_EXECUTIVE
  TREASURER
  EVENT_MANAGER
  HEAD
  SOCIAL_MEDIA_MANAGER
  CO_HEAD
  CORE_MEMBER
  LEARNER
}